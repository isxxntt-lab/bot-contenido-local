__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Salida generada y archivos temporales
output/
*.log
*.tmp
*.temp
*.bak
.cache/
tmp/
temp/

# Sistema
Thumbs.db
Desktop.ini
.DS_Store

# Credenciales de YouTube (client_secret.json y token)
