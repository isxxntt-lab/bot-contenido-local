{
  "canal": "Clipazos ES",
  "formato": "curiosidades",
  "idioma": "es",
  "shorts_por_dia": 1,
  "subida_youtube": {
    "activa": false,
    "privacidad": "public"
  },
  "dias_guardar_videos": 14,
  "render": {
    "ancho": 1080,
    "alto": 1920,
    "fps": 30,
    "codec_video": "libx264",
    "preset": "medium",
    "crf": 18,
    "pix_fmt": "yuv420p",
    "codec_audio": "aac",
    "bitrate_audio": "192k",
    "frecuencia_audio": 48000,
    "loudness_lufs": -14,
    "loudness_tp": -1.5,
    "loudness_lra": 11,
    "movflags": "+faststart"
  },
  "subtitulos": {
    "fuente": "Arial Black",
    "tamano": 78,
    "tamano_titulo": 72,
    "color_bgr": "FFFFFF",
    "resalte_bgr": "00FFFF",
    "contorno": 5,
    "sombra": 3,
    "contorno_titulo": 4,
    "sombra_titulo": 2,
    "alineacion": 2,
    "alineacion_titulo": 8,
    "margen_lateral": 90,
    "margen_inferior": 480,
    "margen_superior": 250,
    "espaciado": 0,
    "negrita": -1,
    "palabras_por_linea": 3,
    "escala_palabra_activa": 130,
    "fundido_entrada_ms": 20,
    "fundido_salida_ms": 40,
    "duracion_minima_palabra": 0.08,
    "titulo_segundos": 2.5,
    "directorio_fuentes": "C:\\Windows\\Fonts"
  },
  "publication": {
    "kill_switch": false,
    "kill_switch_file": "STOP_YOUTUBE",
    "max_por_dia": 3,
    "max_por_ejecucion": 3,
    "max_por_streamer_dia": 1,
    "zona_horaria": "Europe/Madrid",
    "db_path": "data/publicaciones.sqlite3"
  },
  "qa": {
    "activa": true,
    "ancho": 1080,
    "alto": 1920,
    "fps": 30,
    "fps_tolerancia": 0.5,
    "duracion_min": 8,
    "duracion_max": 180,
    "lufs_min": -18,
    "lufs_max": -10,
    "negro_max_segundos": 1.0,
    "negro_umbral_pixel": 0.1,
    "congelado_max_segundos": 2.0,
    "congelado_ruido_db": -60,
    "subtitulos_obligatorios": true,
    "subtitulos_min_eventos": 3,
    "timeout_segundos": 600,
    "caras": {
      "activa": false,
      "muestras": 8,
      "min_fotogramas_con_cara": 1,
      "puntuacion_min": 0.7
    }
  },
  "tiktok_export": {
    "enabled": true,
    "carpeta": "export_tiktok",
    "carpeta_visible": "{DESKTOP}\\Clipazos TikTok",
    "hashtags_base": [
      "#curiosidades",
      "#datocurioso",
      "#sabiasque",
      "#fyp"
    ],
    "max_hashtags": 10,
    "optimizar_video": true,
    "portada_muestras": 9,
    "portada_ventana_segundos": 2.0,
    "timeout_segundos": 300
  }
}
