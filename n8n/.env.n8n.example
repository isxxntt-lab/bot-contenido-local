# Claves de servicios externos del workflow "Bot Contenido — Renderer".
# Rellena cada valor y ejecuta:  docker compose up -d   (recrea el contenedor)
# Estas variables se leen en n8n con $env.NOMBRE_VARIABLE.

# Pexels (B-roll vertical) — gratis: https://www.pexels.com/api/
PEXELS_API_KEY=

# JSON2Video (render Fase 1) — gratis 600 créditos: https://json2video.com
JSON2VIDEO_API_KEY=

# Chat de Telegram para avisos (ID numérico; consíguelo escribiendo a @userinfobot)
TELEGRAM_CHAT_ID=
