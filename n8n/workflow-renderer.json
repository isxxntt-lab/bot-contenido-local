            { "id": "a6", "name": "guion", "value": "={{ $json.body.video.guion }}", "type": "string" },
            { "id": "a7", "name": "hashtags", "value": "={{ ($json.body.video.hashtags || []).join(' ') }}", "type": "string" },
            { "id": "a8", "name": "voz", "value": "={{ $json.body.video.voz || 'es-ES-AlvaroNeural' }}", "type": "string" },
