      "id": "responder-200",
      "name": "Aceptar (HTTP 200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, -160]
    },
    {
      "parameters": {
        "content": "## 🔎 B-ROLL\nPexels API (gratis con clave en $env.PEXELS_API_KEY).\nBusca vídeo vertical según las keywords del payload y selecciona hasta 4 clips.",
        "height": 200,
        "width": 320,
        "color": 5
      },
      "id": "sticky-broll",
      "name": "Sticky — B-Roll",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [400, 140]
    },
    {
      "parameters": {
        "url": "https://api.pexels.com/videos/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.broll_keywords }}" },
            { "name": "per_page", "value": "6" },
            { "name": "orientation", "value": "portrait" },
            { "name": "size", "value": "medium" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $env.PEXELS_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "pexels-buscar",
      "name": "Pexels: Buscar B-Roll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 220]
    },
    {
      "parameters": {
        "jsCode": "// Selecciona hasta 4 clips verticales de Pexels y los adjunta al payload.\nconst base = $('Normalizar Payload').first().json;\nconst data = $input.first().json;\nconst clips = [];\nfor (const video of data.videos || []) {\n  const verticales = (video.video_files || [])\n    .filter((f) => f.height >= f.width)\n    .sort((a, b) => (b.height || 0) - (a.height || 0));\n  if (verticales.length > 0) {\n    clips.push({\n      url: verticales[0].link,\n      duracion: video.duration,\n      creditos: video.user ? video.user.name : 'Pexels',\n    });\n  }\n  if (clips.length >= 4) break;\n}\nif (clips.length === 0) {\n  throw new Error('Pexels no devolvio clips verticales para: ' + base.broll_keywords);\n}\nreturn [{ json: { ...base, clips } }];"
      },
      "id": "seleccionar-clips",
      "name": "Seleccionar Clips",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 220]
    },
    {
      "parameters": {
        "content": "## 🎬 RENDER\nMotor intercambiable vía `payload.render.motor`:\n- **json2video** → API cloud (plantilla + variables). Fase 1.\n- **remotion** → render local sin watermark, $0 real. Fase 2.\n\nClona el bloque Esperar→Estado→IF para Shotstack si lo añades.",
        "height": 260,
        "width": 340,
        "color": 6
      },
      "id": "sticky-render",
      "name": "Sticky — Render",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [840, 340]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "id": "c-json2video",
                    "leftValue": "={{ $json.motor }}",
                    "rightValue": "json2video",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "json2video"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "id": "c-remotion",
                    "leftValue": "={{ $json.motor }}",
                    "rightValue": "remotion",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "remotion"
            }
          ]
        },
        "options": {}
      },
      "id": "elegir-motor",
      "name": "Elegir Motor",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [880, 220]
    },
    {
      "parameters": {
        "jsCode": "// TechNewsVertical v1: construye el movie JSON de JSON2Video desde el payload normalizado.\n// Edita aqui el estilo del video (fuentes, colores, tiempos). Referencia: json2video.com/docs\nconst p = $json;\nconst urls = (p.clips || []).map((c) => c.url).filter(Boolean);\nconst o = {\n  comment: 'TechNewsVertical v1 - Bot Contenido Local',\n  quality: 'high',\n  width: 1080,\n  height: 1920,\n  scenes: [],\n  elements: [\n    {\n      type: 'subtitles',\n      language: 'es',\n      model: 'default',\n      settings: {\n        style: 'classic-one-word',\n        position: 'custom',\n        x: 540,\n        y: 1480,\n        'font-family': 'Oswald',\n        'font-size': 92,\n        'max-words-per-line': 1,\n        'all-caps': true,\n        'word-color': '#FFE900',\n        'line-color': '#FFFFFF',\n        'outline-color': '#000000',\n        'outline-width': 6,\n      },\n    },\n  ],\n};\n\n// Escena 1 - HOOK: b-roll con titular y badge de fuente (5s)\nconst hook = { comment: 'HOOK', elements: [] };\nif (urls.length > 0) {\n  hook.elements.push({ type: 'video', src: urls[0], resize: 'cover', position: 'center-center', duration: 5, muted: true, 'fade-in': 0.3 });\n}\nhook.elements.push(\n  { type: 'text', text: p.titulo, duration: 5, 'fade-in': 0.4, 'fade-out': 0.5, position: 'custom', x: 'center', y: '18%', width: '84%', 'z-index': 5,\n    settings: { 'font-family': 'Oswald', 'font-size': '76px', 'font-weight': '700', color: '#FFFFFF', 'text-align': 'center', 'background-color': 'rgba(10,10,20,0.60)', padding: '22px' } },\n  { type: 'text', text: p.fuente, duration: 5, start: 0.5, 'fade-in': 0.4, position: 'custom', x: 'center', y: '33%', width: '40%', 'z-index': 6,\n    settings: { 'font-family': 'Roboto', 'font-size': '34px', 'font-weight': '500', color: '#0B0B0F', 'background-color': '#FFE900', 'text-align': 'center', padding: '8px 18px' } }\n);\no.scenes.push(hook);\n\n// Escena 2 - CUERPO: locucion completa; los subtitulos de la movie se sincronizan solos\nconst cuerpo = { comment: 'CUERPO', elements: [] };\nif (urls.length > 1) {\n  cuerpo.elements.push({ type: 'video', src: urls[1], resize: 'cover', position: 'center-center', duration: -2, muted: true, loop: -1 });\n}\ncuerpo.elements.push({ type: 'voice', voice: p.voz, model: 'azure', text: p.guion, 'extra-time': 1.2 });\no.scenes.push(cuerpo);\n\n// Escena 3 - CTA: cierre con hashtags (3s)\nconst cta = { comment: 'CTA', elements: [] };\nif (urls.length > 2) {\n  cta.elements.push({ type: 'video', src: urls[2], resize: 'cover', position: 'center-center', duration: 3, muted: true, 'fade-out': 0.6 });\n}\ncta.elements.push({ type: 'text', text: p.hashtags || 'Sigeme para mas #IA #tecnologia', duration: 3, 'fade-in': 0.3, position: 'custom', x: 'center', y: '72%', width: '86%', 'z-index': 5,\n  settings: { 'font-family': 'Oswald', 'font-size': '44px', 'font-weight': '600', color: '#FFFFFF', 'text-align': 'center' } });\no.scenes.push(cta);\n\nreturn [{ json: { ...p, movie: o } }];"
      },
